# Application Settings
LOG_LEVEL=INFO
CONFIG_PATH=config/students.yaml
SECRETS_PATH=secrets/google-service-account.json
DATA_DIR=data
RUN_SCHEDULE="06:00"

# Google Sheets
GOOGLE_SPREADSHEET_ID_OR_NAME=Canvas_Student_Assignments

